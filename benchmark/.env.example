# Copy to .env; docker compose reads it from this directory.

# PostgreSQL (shared by both stacks; databases laravel_app / nestjs_app)
DB_USERNAME=postgres
DB_PASSWORD=change-me

# JWT (HS256), same secret and claim set for both applications.
# JWT_TTL is in seconds; config/jwt.php converts it to the minutes jwt-auth expects.
JWT_SECRET=change-me-to-a-64-char-random-string
JWT_TTL=3600

# Laravel encryption key: base64:<32 random bytes>, e.g. `openssl rand -base64 32`
APP_KEY=base64:change-me

# NestJS pg pool size per PM2 worker (4 workers). Main runs: 10; S2 control run: 1.
DB_POOL_SIZE=10

# Frozen reference date ("now") for the seeded dataset and the EP6 window.
# Change it only together with a re-seed (scripts/db-setup.sh).
BENCH_NOW=2026-09-01 00:00:00

# Container limits, identical for both application stacks
APP_CPUS=4
APP_MEMORY=2g
NGINX_CPUS=1
NGINX_MEMORY=256m
DB_CPUS=4
DB_MEMORY=2g
